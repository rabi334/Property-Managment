## Runtime connection string (can be pooled/PgBouncer on Neon/Vercel)
DATABASE_URL="postgresql://user:password@host:5432/property_manager?sslmode=require"

## Direct (non-pooled) connection string for migrations/long transactions
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/property_manager?sslmode=require"

## Back-compat alias (optional). If you set this, also set DATABASE_URL_UNPOOLED.
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/property_manager?sslmode=require"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
PORT=3001

